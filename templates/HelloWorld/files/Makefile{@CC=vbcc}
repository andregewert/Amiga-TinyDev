# Makefile of {$NAME}.
#
# Needs vbcc (the command vc, set up for AmigaOS 68k) and a make for
# AmigaOS (GNU make); the commands run in the AmigaShell.

CC = vc
CFLAGS = -O1
DEBUGFLAGS = -g

{$NAME}: {$NAME}.c
	$(CC) $(CFLAGS) -o {$NAME} {$NAME}.c

# The program with debug information, for a source-level debugger
# (Build/Debug).
{$NAME}.debug: {$NAME}.c
	$(CC) $(DEBUGFLAGS) -o {$NAME}.debug {$NAME}.c

debug: {$NAME}.debug

clean:
	-Delete {$NAME} {$NAME}.debug QUIET

.PHONY: clean debug
