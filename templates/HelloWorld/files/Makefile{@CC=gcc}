# Makefile of {$NAME}.
#
# Needs gcc for AmigaOS 68k (with libnix, for -noixemul) and a make for
# AmigaOS (GNU make); the commands run in the AmigaShell.

CC = gcc
CFLAGS = -O2 -noixemul
DEBUGFLAGS = -g -O0 -noixemul

{$NAME}: {$NAME}.c
	$(CC) $(CFLAGS) -o {$NAME} {$NAME}.c

# The program with debug information, for a source-level debugger
# (Build/Debug).
{$NAME}.debug: {$NAME}.c
	$(CC) $(DEBUGFLAGS) -o {$NAME}.debug {$NAME}.c

debug: {$NAME}.debug

clean:
	-Delete {$NAME} {$NAME}.debug QUIET

.PHONY: clean debug
