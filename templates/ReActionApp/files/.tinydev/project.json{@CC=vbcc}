{
  "version": 1,
  "name": "{$PROJECT}",
  "build": [
    { "name": "Build", "command": "make", "default": true },
    { "name": "Rebuild", "command": ["make clean", "make"] },
    { "name": "Compile file", "command": "vc -O1 -c \"{file}\" -o \"{base}.o\"" },
    { "name": "Debug build", "command": "make debug" }
  ],
  "run": [
    { "name": "{$NAME}", "command": "{$NAME}", "default": true }
  ],
  "debug": [
    { "name": "BDebug", "command": "BDebug {$NAME}.debug", "default": true }
  ]
}
